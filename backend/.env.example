# ─────────────────────────────────────────────────────────────────────────────
# Gym ERP – Backend Environment Variables (.env.example)
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is gitignored by default.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development           # Use 'production' in production
PORT=5000
CLIENT_URL=http://localhost:5173  # REQUIRED in production (set to your frontend URL)

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/gym-erp

# ── Encryption (Required) ─────────────────────────────────────────────────────
# Used for encrypting sensitive credentials in the DB (like email app passwords).
# Generate a 32-byte hex key. DO NOT change this once set in production or 
# previously encrypted data will become undecryptable.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<replace_with_32_byte_hex>

# ── JWT ───────────────────────────────────────────────────────────────────────
# CRITICAL: Generate real secrets before going to production.
# Run in a Node.js shell:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=<replace_with_crypto_randomBytes_64_hex>
JWT_REFRESH_SECRET=<replace_with_crypto_randomBytes_64_hex>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# ── Cloudinary (photo uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Nodemailer / Gmail App Password) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gym ERP <no-reply@gymerp.com>"

# ── SMS / WhatsApp (placeholder — configure Twilio / Gupshup as needed) ────────
SMS_API_KEY=
WHATSAPP_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION-ONLY: Cross-Origin Cookie Configuration
# Required when frontend and backend are on DIFFERENT domains/origins
# (e.g. Vercel frontend + Render/Railway backend).
#
# The frontend dev-server proxy makes everything same-origin locally, so these
# are not needed in development. Without them in production, the refresh-token
# cookie is silently rejected by browsers (SameSite=Lax blocks cross-origin XHR)
# and users appear to get logged out every 15 minutes.
# ─────────────────────────────────────────────────────────────────────────────

# Set to 'none' for cross-origin (different domains), 'lax' for same-site.
# 'none' REQUIRES REFRESH_COOKIE_SECURE=true (browsers reject 'none' without Secure).
# REFRESH_COOKIE_SAMESITE=none

# Must be 'true' in production (HTTPS) and when SAMESITE=none.
# REFRESH_COOKIE_SECURE=true

# Set if frontend and backend share a top-level domain (e.g. app.example.com + api.example.com):
# REFRESH_COOKIE_DOMAIN=.example.com
