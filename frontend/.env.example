# Gym ERP – Frontend Environment Variables
# ─────────────────────────────────────────
# In development, Vite's dev server proxies /api → http://localhost:5000
# automatically (see vite.config.js). No variables are needed locally.
#
# For PRODUCTION builds, set:
#   VITE_API_URL=https://your-backend-url.com/api
#
# Example (Render/Railway backend):
#   VITE_API_URL=https://gym-erp-api.onrender.com/api
#
# Example (same domain, /api prefix):
#   VITE_API_URL=/api

VITE_API_URL=
